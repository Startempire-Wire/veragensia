#!/usr/bin/env python3
"""Veragens preview CLI: scoped read-only Work views and diagnostics."""
import argparse
import hashlib
import html
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import sys

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "config/v0.1-release-candidate.json"

# V201-S2 registry module (loaded by path; the CLI never mutates it).
import importlib.util as _importlib_util
_spec = _importlib_util.spec_from_file_location(
    "veragens_operations", ROOT / "scripts/veragens-operations.py")
operations = _importlib_util.module_from_spec(_spec)
_spec.loader.exec_module(operations)

# V201-S3 keybinding parity module (loaded by path; read-only).
_parity_spec = _importlib_util.spec_from_file_location(
    "veragens_keymap_parity", ROOT / "scripts/veragens-keymap-parity.py")
keymap_parity = _importlib_util.module_from_spec(_parity_spec)
_parity_spec.loader.exec_module(keymap_parity)
MAX_MANIFEST_BYTES = 65536
MAX_ARTIFACT_BYTES = 512 * 1024 * 1024
FOCUSA_READ_TIMEOUT = 5.0  # Daemon-backed reads need more headroom than local inventory probes.
REQUIRED_GATES = tuple(f"G{i:02}" for i in range(14))
REQUIRED_FIELDS = {
    "platform": ("architecture", "omarchy_version", "hyprland_version", "waybar_version",
                 "iso_digest", "compatibility_evidence_ref"),
    "focusa_candidate": ("version", "runtime_schema_evidence_ref", "authentication_evidence_ref"),
    "native_artifacts": ("installer_revision", "session_bridge_revision", "shell_plugin_revision",
                         "workforce_artifact_ref", "agent_adapter_ref", "containment_evidence_ref"),
}


def artifact_hash(path, expected):
    """Read local bytes only; the artifact is never executed or downloaded."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as source:
            info = os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode):
                return "unsupported_file_type"
            if info.st_size > MAX_ARTIFACT_BYTES:
                return "oversized"
            sha = hashlib.sha256()
            total = 0
            while chunk := source.read(min(1024 * 1024, MAX_ARTIFACT_BYTES - total + 1)):
                total += len(chunk)
                if total > MAX_ARTIFACT_BYTES:
                    return "oversized"
                sha.update(chunk)
    except FileNotFoundError:
        return "missing"
    except OSError:
        return "unreadable"
    return "match" if sha.hexdigest() == expected else "mismatch"


def host_platform():
    """Observe this host, not the unqualified target device; omit its hostname."""
    fields = {"system": None, "kernel_release": None, "architecture": None}
    error_class = None
    try:
        info = os.uname()
        fields.update(system=info.sysname, kernel_release=info.release, architecture=info.machine)
    except (AttributeError, OSError) as exc:
        error_class = type(exc).__name__
    fields = {key: value if value and value.lower() != "unknown" else None for key, value in fields.items()}
    status = "observed" if all(fields.values()) else "partial" if any(fields.values()) else "unknown"
    return {"status": status, **fields, "error_class": error_class,
            "scope": "current_host_only", "native_qualification": "not_verified"}


def pin_match(expected, observed):
    if not all(isinstance(value, str) and value.strip() and value.lower() != "unknown"
               for value in (expected, observed)):
        return None
    return expected == observed


def manifest_gaps(path, artifact_dir=None, observed_architecture=None, observed_focusa_version=None):
    """Report metadata gaps; never treat a supplied evidence ref as verified proof."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as source:
            if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
                return {"status": "unsupported_file_type", "gaps": []}
            raw = source.read(MAX_MANIFEST_BYTES + 1)
    except FileNotFoundError:
        return {"status": "missing", "gaps": []}
    except OSError:
        return {"status": "unreadable", "gaps": []}
    if len(raw) > MAX_MANIFEST_BYTES:
        return {"status": "oversized", "gaps": []}
    try:
        data = json.loads(raw)
    except (ValueError, UnicodeError, RecursionError):
        return {"status": "invalid_json", "gaps": []}
    if not isinstance(data, dict) or data.get("schema") != "veragensia.release_candidate.v1":
        return {"status": "unsupported_schema", "gaps": []}
    gaps = []
    for section, fields in REQUIRED_FIELDS.items():
        values = data.get(section)
        if not isinstance(values, dict):
            gaps.append({"field": section, "reason": "missing_or_invalid_section"})
            continue
        for field in fields:
            value = values.get(field)
            if not isinstance(value, str) or not value.strip():
                gaps.append({"field": f"{section}.{field}", "reason": "missing_or_invalid_value"})
    platform = data.get("platform")
    expected_architecture = platform.get("architecture") if isinstance(platform, dict) else None
    architecture_match = pin_match(expected_architecture, observed_architecture)
    if architecture_match is False:
        gaps.append({"field": "platform.architecture", "reason": "host_architecture_mismatch"})
    hardware = data.get("hardware")
    if not isinstance(hardware, dict) or hardware.get("actual_board_verified") is not True:
        gaps.append({"field": "hardware.actual_board_verified", "reason": "not_asserted"})
    candidate = data.get("focusa_candidate")
    cli_version_match = pin_match(candidate.get("version") if isinstance(candidate, dict) else None,
                                  observed_focusa_version)
    if cli_version_match is False:
        gaps.append({"field": "focusa_candidate.version", "reason": "focusa_cli_version_mismatch"})
    artifacts = candidate.get("artifacts") if isinstance(candidate, dict) else None
    # Artifact rows are located by role + pinned version, not one frozen name:
    # legacy releases shipped `focusa`/`focusa-daemon`; v0.9.191+ ships
    # `focusa-v<version>-<target-triple>` assets. Names are declared by the
    # existing candidate contract, never executed or downloaded.
    if not isinstance(artifacts, list):
        artifacts = []
    # The artifact names embed the FOCUSA release version (focusa_candidate.version),
    # not Veragensia's own target_version.
    pinned_version = (data.get("focusa_candidate") or {}).get("version") if isinstance(data, dict) else None

    def artifact_rows(role):
        # name == role (legacy), or role + "-v" + pinned version + optional
        # "-" + target triple (v0.9.191+ naming). The version boundary keeps
        # `focusa-daemon-…` from matching the `focusa` role.
        prefixes = (f"{role}-v{pinned_version}",) if isinstance(pinned_version, str) and pinned_version else ()
        rows = []
        for a in artifacts:
            if not isinstance(a, dict):
                continue
            name = a.get("name")
            if name == role or (isinstance(name, str) and any(
                    name == prefix or name.startswith(prefix + "-") for prefix in prefixes)):
                rows.append(a)
        return rows

    artifact_checks = []
    for role in ("focusa", "focusa-daemon"):
        rows = artifact_rows(role)
        if len(rows) != 1 or not isinstance(rows[0].get("sha256"), str) or not re.fullmatch(r"[0-9a-f]{64}", rows[0]["sha256"]):
            gaps.append({"field": f"focusa_candidate.artifacts.{role}", "reason": "missing_or_invalid_digest"})
            if artifact_dir is not None:
                artifact_checks.append({"name": role, "status": "invalid_metadata"})
        elif artifact_dir is not None:
            status = artifact_hash(Path(artifact_dir) / rows[0]["name"], rows[0]["sha256"])
            artifact_checks.append({"name": role, "status": status})
            if status != "match":
                gaps.append({"field": f"focusa_candidate.artifacts.{role}", "reason": status})
    gates = data.get("required_gates")
    if not isinstance(gates, list):
        gates = []
    for gate_id in REQUIRED_GATES:
        rows = [g for g in gates if isinstance(g, dict) and g.get("id") == gate_id]
        if len(rows) != 1:
            reason = "missing_or_duplicate_gate"
        elif rows[0].get("status") != "pass":
            reason = "not_passed"
        elif not isinstance(rows[0].get("evidence_ref"), str) or not rows[0]["evidence_ref"].strip():
            reason = "missing_evidence_reference"
        else:
            continue
        gaps.append({"field": f"required_gates.{gate_id}", "reason": reason})
    hash_status = "not_performed" if artifact_dir is None else (
        "matched" if all(c["status"] == "match" for c in artifact_checks) else "failed")
    return {"status": "gaps_found" if gaps else "metadata_present_unverified", "gaps": gaps,
            "artifact_hash_verification": hash_status, "artifact_checks": artifact_checks,
            "architecture_match": architecture_match, "focusa_cli_version_match": cli_version_match,
            "evidence_verification": "not_performed"}


def inventory_module():
    spec = importlib.util.spec_from_file_location("veragens_inventory", ROOT / "scripts/veragens-omarchy-inventory.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def runtime_inventory():
    return inventory_module().inventory(Path.home())


def focusa_cli_version(runner=None):
    state, raw = (runner or inventory_module().probe)(["focusa", "--version"])
    if state["status"] != "ok":
        return {**state, "version": None}
    try:
        text = raw.decode("utf-8").strip()
    except UnicodeError:
        return {"status": "invalid_output", "version": None}
    match = re.fullmatch(r"focusa ([0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?)", text)
    if not match:
        return {"status": "invalid_output", "version": None}
    return {"status": "observed", "version": match[1]}


def resume(project_root, continuity_id, runner=None):
    """Forward one explicit read to Focusa; never dispatch or resume execution."""
    root = Path(project_root)
    if not root.is_absolute() or not root.is_dir() or not continuity_id.strip():
        return {"status": "blocked", "reason": "explicit_local_scope_required"}, 2
    module = inventory_module()
    state, data = module.json_probe(
        ["focusa", "workpoint", "resume", f"--project-root={root}",
         f"--continuity-id={continuity_id}", "--json"],
        runner or (lambda argv: module.probe(argv, timeout=FOCUSA_READ_TIMEOUT)))
    if state["status"] != "ok":
        failure = {"status": "blocked", "reason": f"focusa_{state['status']}"}
        if "exit_code" in state:
            failure["exit_code"] = state["exit_code"]
        if "reason" in state:
            failure["upstream_reason"] = state["reason"]
        return failure, 2
    if not isinstance(data, dict) or data.get("schema_version") != "focusa.workpoint_resume_packet.v2":
        return {"status": "blocked", "reason": "unsupported_focusa_reply"}, 2
    packet = data.get("resume_packet")
    if not isinstance(packet, dict) or packet.get("project_root") != str(root) or packet.get("continuity_id") != continuity_id:
        return {"status": "blocked", "reason": "focusa_scope_mismatch"}, 2
    if (data.get("status") != "completed" or data.get("canonical") is not True
            or packet.get("canonical") is not True or data.get("degraded") is True):
        return {"status": "blocked", "reason": "focusa_continuation_unavailable"}, 2
    return data, 0


def waybar_frame(report, code):
    """Render a validated continuation, not scheduler/worker health or authority."""
    def text(value, limit):
        if not isinstance(value, str):
            return "unknown"
        clean = " ".join("".join(c for c in value if c.isprintable() or c.isspace()).split())
        if not clean:
            return "unknown"
        return html.escape(clean[:limit] + ("…" if len(clean) > limit else ""))

    if code:
        return {"text": "Work: unavailable", "alt": "unavailable", "class": "unavailable",
                "tooltip": "Scoped Focusa read unavailable; no prior state retained.\n"
                           + text(report.get("reason"), 120)}
    packet = report["resume_packet"]
    stale = bool(packet.get("stale_note"))
    label = "stale" if stale else "checkpoint"
    return {"text": ("Work (stale): " if stale else "Work: ") + text(packet.get("mission"), 64),
            "alt": label, "class": label,
            "tooltip": "\n".join([
                "Focusa Work — " + label + " (not live worker status)",
                "Project: " + text(packet.get("project_root"), 240),
                "Mission: " + text(packet.get("mission"), 240),
                "Workpoint state: " + text(packet.get("status"), 64),
                "Next: " + text(packet.get("next_slice"), 512),
                "Checkpoint updated: " + text(packet.get("updated_at"), 64),
                *(["Stale: " + text(packet.get("stale_note"), 160)] if stale else []),
                "Read-only; no execution or scope changes."])}


def doctor(path=MANIFEST, collector=runtime_inventory, artifact_dir=None):
    platform = host_platform()
    cli = focusa_cli_version()
    manifest = manifest_gaps(path, artifact_dir, platform["architecture"], cli["version"])
    remaining = ["native_target_qualification", "release_evidence_verification"]
    if manifest.get("artifact_hash_verification") != "matched":
        remaining.append("dependency_artifact_hash_verification")
    return {"schema": "veragensia.doctor.v1", "mode": "read_only",
            "status": "incomplete", "release_ready": False,
            "manifest": manifest, "platform": platform, "dependencies": {"focusa_cli": cli},
            "runtime": collector(),
            "remaining_checks": remaining,
            "note": "Candidate assertions are not verified release evidence; this diagnostic never certifies readiness."}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    diagnostic = commands.add_parser("doctor", help="report candidate and local runtime gaps without repairs")
    diagnostic.add_argument("--json", action="store_true", required=True)
    diagnostic.add_argument("--manifest", type=Path, default=MANIFEST, help="candidate metadata to inspect locally")
    diagnostic.add_argument("--artifact-dir", type=Path,
                            help="opt in to hashing local pinned dependency files; never executes them")
    continuation = commands.add_parser("resume", help="read an explicitly scoped Focusa continuation; never start execution")
    continuation.add_argument("--project-root", required=True)
    continuation.add_argument("--continuity-id", required=True)
    continuation.add_argument("--json", action="store_true", help="JSON output (also the default)")
    status = commands.add_parser("status", help="read scoped Work state; optionally render a Waybar frame")
    status.add_argument("--project-root", required=True)
    status.add_argument("--continuity-id", required=True)
    output = status.add_mutually_exclusive_group(required=True)
    output.add_argument("--json", action="store_true", help="unchanged validated Focusa continuation envelope")
    output.add_argument("--waybar", action="store_true", help="bounded read-only Work text and tooltip")
    # V201-S2: semantic operation registry projections (read-only; S4 wires execution).
    operation = commands.add_parser("operation", help="semantic system-operation registry (docs/201 V201-S2)")
    operation_commands = operation.add_subparsers(dest="operation_command", required=True)
    operation_list = operation_commands.add_parser("list", help="bounded list of registered semantic operations")
    operation_list.add_argument("--json", action="store_true", required=True)
    operation_list.add_argument("--registry", type=Path, default=None,
                                help="registry path override (default: repo config/system-operations.json)")
    operation_describe = operation_commands.add_parser("describe", help="full descriptor for one operation id")
    operation_describe.add_argument("operation_id")
    operation_describe.add_argument("--json", action="store_true", required=True)
    operation_describe.add_argument("--registry", type=Path, default=None,
                                    help="registry path override (default: repo config/system-operations.json)")
    # V201-S3: keybinding parity projection (read-only; docs/201 4.2 gate + drift).
    keymap = commands.add_parser("keymap", help="keybinding parity projection (docs/201 V201-S3)")
    keymap_commands = keymap.add_subparsers(dest="keymap_command", required=True)
    keymap_inspect = keymap_commands.add_parser("inspect", help="classify live bindings against the semantic operation registry")
    keymap_inspect.add_argument("--inventory", type=Path, required=True,
                                help="V201-S1 inventory report JSON (hyprland_bindings source)")
    keymap_inspect.add_argument("--rules", type=Path, default=None,
                                help="projection rules override (default: repo config/keybinding-projection.json)")
    keymap_inspect.add_argument("--baseline", type=Path, default=None,
                                help="prior projection report; emits projection drift")
    keymap_inspect.add_argument("--json", action="store_true", required=True)
    args = parser.parse_args()
    if args.command == "operation":
        registry = args.registry or operations.REGISTRY_PATH
        if args.operation_command == "list":
            report, code = operations.catalog(registry), 0
        else:
            descriptor = operations.describe(args.operation_id, registry)
            if descriptor is None:
                report, code = {"schema": "veragensia.system_operation_error.v1",
                                "error": "unknown_operation",
                                "operation_id": args.operation_id}, 2
            else:
                report, code = descriptor, 0
        print(json.dumps(report, sort_keys=True))
        return code
    if args.command == "keymap":
        # Read-only parity projection; never executes bindings, never mutates state.
        inventory = json.loads(Path(args.inventory).read_text(encoding="utf-8"))
        rules = keymap_parity.load_rules(args.rules or keymap_parity.RULES_PATH)
        report = keymap_parity.compile_projection(inventory, rules)
        if args.baseline is not None:
            baseline = json.loads(Path(args.baseline).read_text(encoding="utf-8"))
            report = keymap_parity.diff_projection(report, baseline)
        print(json.dumps(report, sort_keys=True))
        return 0
    if args.command in ("resume", "status"):
        report, code = resume(args.project_root, args.continuity_id)
        if args.command == "status" and args.waybar:
            report = waybar_frame(report, code)
            # A valid unavailable frame must reach Waybar rather than hide the widget.
            # Zero means frame emitted, never that Focusa is available or work is done.
            code = 0
    else:
        report, code = doctor(args.manifest, artifact_dir=args.artifact_dir), 2
    print(json.dumps(report, sort_keys=True))
    return code


if __name__ == "__main__":
    # Read-only commands must not create cache files beside the source scripts.
    sys.dont_write_bytecode = True
    raise SystemExit(main())
